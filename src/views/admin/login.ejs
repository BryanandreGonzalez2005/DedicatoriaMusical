<!DOCTYPE html>
<html lang="es">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title><%= titulo %></title>

  <!-- Bootstrap -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <!-- CSS ADMIN -->
  <link
    rel="stylesheet"
    href="/css/admin.css"
  >

</head>


<body>

  <main class="login-container">

    <section class="login-card">

      <!-- ICONO -->
      <div class="login-icon">
        ♪
      </div>


      <!-- TÍTULO -->
      <h1>
        Administración
      </h1>

      <p class="login-subtitle">
        Dedicatoria Musical
      </p>


      <!-- ERROR -->
      <% if (error) { %>

        <div
          class="alert alert-danger"
          role="alert"
        >
          <%= error %>
        </div>

      <% } %>


      <!-- FORMULARIO -->
      <form
        action="/admin/login"
        method="POST"
      >

        <!-- CORREO -->
        <div class="mb-3">

          <label
            for="email"
            class="form-label"
          >
            Correo
          </label>

          <input
            type="email"
            class="form-control"
            id="email"
            name="email"
            placeholder="admin@dedicatoria.com"
            autocomplete="email"
            required
          >

        </div>


        <!-- CONTRASEÑA -->
        <div class="mb-4">

          <label
            for="password"
            class="form-label"
          >
            Contraseña
          </label>

          <input
            type="password"
            class="form-control"
            id="password"
            name="password"
            placeholder="Tu contraseña"
            autocomplete="current-password"
            required
          >

        </div>


        <!-- BOTÓN -->
        <button
          type="submit"
          class="btn-login"
        >
          Iniciar sesión
        </button>

      </form>


      <!-- VOLVER -->
      <a
        href="/"
        class="volver"
      >
        ← Volver a las canciones
      </a>

    </section>

  </main>


  <!-- Bootstrap -->
  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js">
  </script>

</body>

</html>