<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css?v=5">
</head>
<body>
<main class="admin-dashboard">
  <div class="admin-shell">
    <div class="admin-topbar">
      <a href="/admin" class="brand">
        <span class="brand-mark">DM</span>
        <span class="brand-copy"><strong>Dedicatoria Musical</strong><span>Panel de administración</span></span>
      </a>
      <a href="/admin/canciones" class="btn-cancelar">Volver</a>
    </div>
    <div class="admin-layout">
      
      <aside class="admin-sidebar">
        <p class="sidebar-label">Navegación</p>
        <nav class="sidebar-nav">
          <a href="/admin" class="sidebar-link ">
            <svg viewBox="0 0 24 24"><path d="M3 11.5 12 4l9 7.5"/><path d="M5 10.5V20h14v-9.5"/><path d="M9 20v-6h6v6"/></svg>
            <span>Inicio</span>
          </a>
          <a href="/admin/canciones" class="sidebar-link active">
            <svg viewBox="0 0 24 24"><path d="M9 18V5l10-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="16" cy="16" r="3"/></svg>
            <span>Canciones</span>
          </a>
          <a href="/" target="_blank" class="sidebar-link">
            <svg viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg>
            <span>Ver página</span>
          </a>
        </nav>
      </aside>

      <section class="admin-content">

        <header class="dashboard-header">
          <div>
            <a href="/admin/canciones" class="volver">← Volver a canciones</a>
            <p class="dashboard-label">Nueva entrada</p>
            <h1>Nueva canción</h1>
            <p class="dashboard-bienvenida">Agrega una nueva canción a tu dedicatoria.</p>
          </div>
        </header>
        <section class="form-cancion-card">
          <% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
          <form action="/admin/canciones/nueva" method="POST" enctype="multipart/form-data">

          <h2 class="form-section-title">Información de la canción</h2>
          <div class="mb-4">
            <label for="titulo" class="form-label">Título de la canción *</label>
            <input type="text" id="titulo" name="titulo" class="form-control" placeholder="Ej: Tear In My Heart" required>
          </div>
          <div class="mb-4">
            <label for="artista" class="form-label">Artista *</label>
            <input type="text" id="artista" name="artista" class="form-control" placeholder="Ej: Twenty One Pilots" required>
          </div>
          <div class="mb-4">
            <label for="dedicatoria" class="form-label">Dedicatoria</label>
            <textarea id="dedicatoria" name="dedicatoria" class="form-control" rows="4" placeholder="Escribe lo que quieres decir con esta canción..."></textarea>
          </div>
          <div class="mb-4">
            <label for="url_musica" class="form-label">URL de YouTube *</label>
            <input type="url" id="url_musica" name="url_musica" class="form-control" placeholder="https://youtu.be/..." required>
            <small class="ayuda-formulario">Pega el enlace normal del video de YouTube.</small>
          </div>
          <div class="mb-4">
            <label for="portada" class="form-label">Portada</label>
            <input type="file" id="portada" name="portada" class="form-control" accept="image/jpeg,image/png,image/webp">
            <small class="ayuda-formulario">Selecciona una imagen JPG, PNG o WEBP. Máximo 5 MB.</small>
          </div>
          <div class="mb-3">
  <label for="categoria" class="form-label">
    Categoría
  </label>

  <input
    type="text"
    class="form-control"
    id="categoria"
    name="categoria"
    placeholder="Ej: Pop, Trap argentino, Románticas"
    required
  >
</div>
          <div class="mb-4">
            <label for="orden" class="form-label">Orden</label>
            <input type="number" id="orden" name="orden" class="form-control" value="0" min="0">
            <small class="ayuda-formulario">Las canciones con números menores aparecen primero.</small>
          </div>
          
          <div class="form-check mb-2">
            <input type="checkbox" id="visible" name="visible" class="form-check-input" checked>
            <label for="visible" class="form-check-label">Mostrar esta canción en la página</label>
          </div>
          <div class="form-check mb-2">
            <input type="checkbox" id="destacada" name="destacada" class="form-check-input">
            <label for="destacada" class="form-check-label">Marcar como destacada</label>
          </div>

            <div class="form-acciones">
              <button type="submit" class="btn-admin-option">Guardar canción</button>
              <a href="/admin/canciones" class="btn-cancelar">Cancelar</a>
            </div>
          </form>
        </section>

      </section>
    </div>
  </div>
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
