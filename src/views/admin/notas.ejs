<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= titulo %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=DM+Sans:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  >

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/css/admin.css?v=5">
</head>

<body>

<main class="admin-dashboard">

  <div class="admin-shell">

    <!-- ===================================== -->
    <!-- BARRA SUPERIOR -->
    <!-- ===================================== -->

    <div class="admin-topbar">

      <a href="/admin" class="brand">

        <span class="brand-mark">
          DM
        </span>

        <span class="brand-copy">
          <strong>
            Dedicatoria Musical
          </strong>

          <span>
            Panel de administración
          </span>
        </span>

      </a>


      <a
        href="/admin/notas/nueva"
        class="btn-admin-option"
      >
        Nueva nota
      </a>

    </div>


    <div class="admin-layout">


      <!-- ===================================== -->
      <!-- MENÚ LATERAL -->
      <!-- ===================================== -->

      <aside class="admin-sidebar">

        <p class="sidebar-label">
          Navegación
        </p>

        <nav class="sidebar-nav">

          <!-- INICIO -->

          <a
            href="/admin"
            class="sidebar-link"
          >

            <svg viewBox="0 0 24 24">
              <path d="M3 11.5 12 4l9 7.5"/>
              <path d="M5 10.5V20h14v-9.5"/>
              <path d="M9 20v-6h6v6"/>
            </svg>

            <span>
              Inicio
            </span>

          </a>


          <!-- CANCIONES -->

          <a
            href="/admin/canciones"
            class="sidebar-link"
          >

            <svg viewBox="0 0 24 24">
              <path d="M9 18V5l10-2v13"/>
              <circle cx="6" cy="18" r="3"/>
              <circle cx="16" cy="16" r="3"/>
            </svg>

            <span>
              Canciones
            </span>

          </a>


          <!-- NOTAS -->

          <a
            href="/admin/notas"
            class="sidebar-link active"
          >

            <svg viewBox="0 0 24 24">
              <path d="M4 4h16v16H4z"/>
              <path d="M7 8h10"/>
              <path d="M7 12h10"/>
              <path d="M7 16h6"/>
            </svg>

            <span>
              Notas
            </span>

          </a>


          <!-- VER PÁGINA -->

          <a
            href="/"
            target="_blank"
            class="sidebar-link"
          >

            <svg viewBox="0 0 24 24">
              <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/>
              <circle cx="12" cy="12" r="2.5"/>
            </svg>

            <span>
              Ver página
            </span>

          </a>

        </nav>

      </aside>


      <!-- ===================================== -->
      <!-- CONTENIDO -->
      <!-- ===================================== -->

      <section class="admin-content">

        <header class="dashboard-header">

          <div>

            <a
              href="/admin"
              class="volver"
            >
              ← Volver al panel
            </a>

            <p class="dashboard-label">
              Mensajes
            </p>

            <h1>
              Notas
            </h1>

            <p class="dashboard-bienvenida">
              Administra los mensajes que aparecen
              en la sección "Ábreme".
            </p>

          </div>

        </header>


        <!-- ===================================== -->
        <!-- LISTADO DE NOTAS -->
        <!-- ===================================== -->

        <% if (notas && notas.length > 0) { %>

          <div class="song-grid">

            <% notas.forEach((nota) => { %>

              <article class="admin-option song-card">

                <div class="song-card-body">

                  <!-- TÍTULO -->

                  <h2>
                    <%= nota.titulo %>
                  </h2>


                  <!-- FECHA -->

                  <% if (nota.fecha) { %>

                    <p class="song-artist">

                      <%= new Date(
                        nota.fecha + "T00:00:00"
                      ).toLocaleDateString(
                        "es-EC",
                        {
                          day: "2-digit",
                          month: "long",
                          year: "numeric"
                        }
                      ) %>

                    </p>

                  <% } else { %>

                    <p class="song-artist">
                      Sin fecha
                    </p>

                  <% } %>


                  <!-- ESTADO -->

                  <div class="song-status">

                    <% if (nota.visible) { %>

                      <span class="estado-visible">
                        Visible
                      </span>

                    <% } else { %>

                      <span class="estado-oculta">
                        Oculta
                      </span>

                    <% } %>


                    <span class="estado-destacada">
                      Orden: <%= nota.orden %>
                    </span>

                  </div>


                  <!-- VISTA PREVIA -->

                  <p>

                    <%
                      const resumen =
                        nota.contenido.length > 150
                          ? nota.contenido.substring(
                              0,
                              150
                            ) + "..."
                          : nota.contenido;
                    %>

                    <%= resumen %>

                  </p>


                  <!-- ACCIONES -->

                  <div class="acciones-cancion">

                    <a
                      href="/admin/notas/<%= nota.id %>/editar"
                      class="btn-admin-option"
                    >
                      Editar
                    </a>


                    <form
                      action="/admin/notas/<%= nota.id %>/eliminar"
                      method="POST"
                      class="form-eliminar"
                      data-titulo="<%= nota.titulo %>"
                    >

                      <button
                        type="submit"
                        class="btn-eliminar"
                      >
                        Eliminar
                      </button>

                    </form>

                  </div>

                </div>

              </article>

            <% }); %>

          </div>


        <% } else { %>


          <!-- ===================================== -->
          <!-- SIN NOTAS -->
          <!-- ===================================== -->

          <article class="admin-option text-center">

            <h2>
              Todavía no hay notas
            </h2>

            <p>
              Crea el primer mensaje para
              la sección "Ábreme".
            </p>

            <a
              href="/admin/notas/nueva"
              class="btn-admin-option"
            >
              Crear primera nota
            </a>

          </article>


        <% } %>

      </section>

    </div>

  </div>

</main>


<script
  src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
></script>

<script
  src="https://cdn.jsdelivr.net/npm/sweetalert2@11"
></script>


<!-- ========================================= -->
<!-- CONFIRMACIÓN PARA ELIMINAR -->
<!-- ========================================= -->

<script>

  document
    .querySelectorAll(".form-eliminar")
    .forEach((form) => {

      form.addEventListener(
        "submit",
        async (event) => {

          event.preventDefault();

          const titulo =
            form.dataset.titulo ||
            "esta nota";


          const resultado =
            await Swal.fire({

              title:
                "¿Eliminar nota?",

              text:
                `Se eliminará "${titulo}". Esta acción no se puede deshacer.`,

              icon:
                "warning",

              showCancelButton:
                true,

              confirmButtonText:
                "Sí, eliminar",

              cancelButtonText:
                "Cancelar",

              reverseButtons:
                true,

              customClass: {

                popup:
                  "admin-swal",

                confirmButton:
                  "admin-swal-confirm",

                cancelButton:
                  "admin-swal-cancel"

              }

            });


          if (
            resultado.isConfirmed
          ) {

            form.submit();

          }

        }

      );

    });

</script>

</body>
</html>