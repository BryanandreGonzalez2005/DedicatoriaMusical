<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= titulo %>
    </title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap"
        rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="/css/cliente.css?v=5">

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body>

    <main class="container py-5">

        <!-- ========================================
         PRESENTACIÓN
    ========================================= -->

        <section class="presentacion text-center">

            <p class="etiqueta-superior">
                Canciones que me hacen pensar en ti
            </p>

            <h1 class="titulo-principal">
                <%= titulo %>
            </h1>

            <p class="subtitulo mx-auto">
                Hay canciones que dicen cosas que a veces las palabras
                no pueden explicar.
            </p>

            <div class="contenedor-abreme">

                <div class="contenedor-abreme">

                    <button type="button" class="button-abreme" id="btnAbrirCarta">
                        <!-- Aquí están los 2 SVG del botón que te pasé -->

                        <span>Presióname</span>
                    </button>

                    <!-- FILTROS PARA EL EFECTO DIBUJADO -->
                    <svg width="0" height="0" aria-hidden="true">
                        <filter id="handDrawnNoise">
                            ...
                        </filter>

                        <filter id="handDrawnNoise2">
                            ...
                        </filter>

                        <filter id="handDrawnNoiset">
                            ...
                        </filter>

                        <filter id="handDrawnNoiset2">
                            ...
                        </filter>
                    </svg>

                </div>

            </div>

        </section>


        <!-- ========================================
         OBTENER CATEGORÍAS
    ========================================= -->

        <% const categorias=[ ...new Set( (canciones || []) .map(cancion=> cancion.categoria || "Sin categoría")
            .filter(Boolean)
            )
            ];
            %>


            <!-- ========================================
         FILTROS
    ========================================= -->

            <% if (canciones && canciones.length> 0) { %>
                <!-- BUSCADOR DE CANCIONES -->
                <div class="buscador-uiverse">

                    <div class="buscador-glow"></div>
                    <div class="buscador-dark-border"></div>
                    <div class="buscador-white"></div>
                    <div class="buscador-border"></div>

                    <div class="buscador-main">

                        <input id="buscadorCanciones" class="buscador-input-uiverse" type="search"
                            placeholder="Buscar canción o artista..." autocomplete="off"
                            aria-label="Buscar canción o artista">

                        <!-- ICONO BUSCAR -->
                        <div class="buscador-search-icon">

                            <svg fill="none" height="24" width="24" viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2"></circle>

                                <line x1="22" y1="22" x2="16.65" y2="16.65" stroke="currentColor" stroke-width="2">
                                </line>
                            </svg>

                        </div>

                        <!-- DECORACIÓN DERECHA -->
                        <div class="buscador-filter-border"></div>

                        <div class="buscador-filter-icon">

                            <svg fill="none" viewBox="4.8 4.56 14.832 15.408" width="27" height="27" aria-hidden="true">
                                <path stroke-linejoin="round" stroke-linecap="round" stroke-width="1" stroke="#d6d6e6"
                                    d="M8.16 6.65002H15.83C16.47 6.65002 16.99 7.17002 16.99 7.81002V9.09002C16.99 9.56002 16.7 10.14 16.41 10.43L13.91 12.64C13.56 12.93 13.33 13.51 13.33 13.98V16.48C13.33 16.83 13.1 17.29 12.81 17.47L12 17.98C11.24 18.45 10.2 17.92 10.2 16.99V13.91C10.2 13.5 9.97 12.98 9.73 12.69L7.52 10.36C7.23 10.08 7 9.55002 7 9.20002V7.87002C7 7.17002 7.52 6.65002 8.16 6.65002Z">
                                </path>
                            </svg>

                        </div>

                    </div>

                </div>
                <section class="seccion-filtros">

                    <p class="filtros-label">
                        Explorar por categoría
                    </p>

                    <div class="filtros-categorias" id="filtrosCategorias">

                        <button type="button" class="filtro-categoria active" data-categoria="todas">
                            Todas
                        </button>


                        <% categorias.forEach(categoria=> { %>

                            <button type="button" class="filtro-categoria" data-categoria="<%= categoria %>">
                                <%= categoria %>
                            </button>

                            <% }); %>

                    </div>

                </section>

                <% } %>


                    <!-- ========================================
         CANCIONES
    ========================================= -->

                    <section class="seccion-canciones">

                        <% if (canciones && canciones.length> 0) { %>

                            <div class="row justify-content-center g-4">

                                <% canciones.forEach((cancion, index)=> { %>


                                    <!--
              CELULAR: 1 canción
              TABLET:  2 canciones
              PC:      3 canciones
            -->

                                    <div class="col-12 col-md-6 col-lg-4 contenedor-cancion"
                                        data-categoria="<%= cancion.categoria || 'Sin categoría' %>">


                                        <article class="card tarjeta-cancion h-100" <% if (cancion.url_portada) { %>
                                            style="--fondo-cancion: url('<%= cancion.url_portada %>');"
                                                <% } %>
                                                    >


                                                    <!-- FONDO -->

                                                    <% if (cancion.url_portada) { %>

                                                        <div class="fondo-portada"></div>

                                                        <% } %>


                                                            <div class="capa-oscura"></div>


                                                            <!-- CONTENIDO -->

                                                            <div class="card-body p-4">


                                                                <!-- INFORMACIÓN -->

                                                                <div class="info-cancion">

                                                                    <h2 class="nombre-cancion mb-1">
                                                                        <%= cancion.titulo %>
                                                                    </h2>

                                                                    <p class="artista mb-3">
                                                                        <%= cancion.artista %>
                                                                    </p>


                                                                    <% if (cancion.dedicatoria) { %>

                                                                        <p class="dedicatoria mb-4">
                                                                            “<%= cancion.dedicatoria %>”
                                                                        </p>

                                                                        <% } %>

                                                                </div>


                                                                <!-- ========================================
                       REPRODUCTOR YOUTUBE
                  ========================================= -->

                                                                <% if ( cancion.plataforma==="youtube" &&
                                                                    cancion.url_embed ) { %>


                                                                    <div class="music-player"
                                                                        data-player-index="<%= index %>">


                                                                        <!-- VINILO GRANDE -->

                                                                        <div class="vinyl-wrap">

                                                                            <div class="vinyl" <% if
                                                                                (cancion.url_portada) { %>
                                                                                style="--vinyl-cover: url('<%=
                                                                                    cancion.url_portada %>');"
                                                                                    <% } %>
                                                                                        >

                                                                                        <div
                                                                                            class="vinyl-groove vinyl-groove-1">
                                                                                        </div>

                                                                                        <div
                                                                                            class="vinyl-groove vinyl-groove-2">
                                                                                        </div>

                                                                                        <div class="vinyl-label"></div>

                                                                                        <div class="vinyl-hole"></div>

                                                                            </div>

                                                                        </div>


                                                                        <!-- PANEL DEL REPRODUCTOR -->

                                                                        <div class="music-panel">


                                                                            <!-- INFORMACIÓN SUPERIOR -->

                                                                            <div class="music-top">

                                                                                <div class="mini-vinyl" <% if
                                                                                    (cancion.url_portada) { %>
                                                                                    style="--vinyl-cover: url('<%=
                                                                                        cancion.url_portada %>');"
                                                                                        <% } %>
                                                                                            >

                                                                                            <div class="vinyl-label">
                                                                                            </div>

                                                                                            <div class="vinyl-hole">
                                                                                            </div>

                                                                                </div>


                                                                                <div class="music-meta">

                                                                                    <strong>
                                                                                        <%= cancion.titulo %>
                                                                                    </strong>

                                                                                    <span>
                                                                                        <%= cancion.artista %>
                                                                                    </span>

                                                                                </div>

                                                                            </div>


                                                                            <!-- BARRA DE PROGRESO -->

                                                                            <div class="music-progress-row">

                                                                                <span class="music-time current-time">
                                                                                    0:00
                                                                                </span>


                                                                                <input type="range"
                                                                                    class="music-progress" min="0"
                                                                                    max="100" value="0" step="0.1"
                                                                                    aria-label="Progreso de la canción">


                                                                                <span class="music-time duration-time">
                                                                                    0:00
                                                                                </span>

                                                                            </div>


                                                                            <!-- CONTROLES -->

                                                                            <div class="music-controls">


                                                                                <!-- ANTERIOR -->

                                                                                <button type="button"
                                                                                    class="music-control music-prev"
                                                                                    aria-label="Canción anterior"
                                                                                    title="Anterior">

                                                                                    <svg viewBox="0 0 24 24"
                                                                                        aria-hidden="true">

                                                                                        <polygon
                                                                                            points="19 20 9 12 19 4 19 20">
                                                                                        </polygon>

                                                                                        <line x1="5" y1="19" x2="5"
                                                                                            y2="5"></line>

                                                                                    </svg>

                                                                                </button>


                                                                                <!-- PLAY / PAUSE -->

                                                                                <button type="button"
                                                                                    class="music-control music-play"
                                                                                    aria-label="Reproducir"
                                                                                    title="Reproducir">

                                                                                    <svg class="icon-play"
                                                                                        viewBox="0 0 24 24"
                                                                                        aria-hidden="true">

                                                                                        <polygon
                                                                                            points="5 3 19 12 5 21 5 3">
                                                                                        </polygon>

                                                                                    </svg>


                                                                                    <svg class="icon-pause"
                                                                                        viewBox="0 0 24 24"
                                                                                        aria-hidden="true">

                                                                                        <rect x="6" y="4" width="4"
                                                                                            height="16"></rect>

                                                                                        <rect x="14" y="4" width="4"
                                                                                            height="16"></rect>

                                                                                    </svg>

                                                                                </button>


                                                                                <!-- SIGUIENTE -->

                                                                                <button type="button"
                                                                                    class="music-control music-next"
                                                                                    aria-label="Canción siguiente"
                                                                                    title="Siguiente">

                                                                                    <svg viewBox="0 0 24 24"
                                                                                        aria-hidden="true">

                                                                                        <polygon
                                                                                            points="5 4 15 12 5 20 5 4">
                                                                                        </polygon>

                                                                                        <line x1="19" y1="5" x2="19"
                                                                                            y2="19"></line>

                                                                                    </svg>

                                                                                </button>

                                                                            </div>

                                                                        </div>


                                                                        <!--
                        YouTube real controlado por cliente.js
                      -->

                                                                        <div class="youtube-host" aria-hidden="true">

                                                                            <div class="youtube-player"
                                                                                id="player-<%= index %>"
                                                                                data-video-url="<%= cancion.url_embed %>">
                                                                            </div>

                                                                        </div>

                                                                    </div>


                                                                    <% } else { %>


                                                                        <!-- ENLACE ALTERNATIVO -->

                                                                        <a href="<%= cancion.url_musica %>"
                                                                            target="_blank" rel="noopener noreferrer"
                                                                            class="button">

                                                                            <span>
                                                                                Escuchar canción
                                                                            </span>

                                                                        </a>


                                                                        <% } %>

                                                            </div>

                                        </article>

                                    </div>

                                    <% }); %>

                            </div>


                            <% } else { %>


                                <!-- SIN CANCIONES -->

                                <div class="text-center">

                                    <p class="sin-canciones">
                                        Pronto habrá algo especial aquí.
                                    </p>

                                </div>


                                <% } %>

                    </section>

    </main>


    <!-- ========================================
       VOLVER ARRIBA
  ========================================= -->

    <button type="button" class="button boton-volver-arriba" id="btnVolverArriba" aria-label="Volver arriba">
        Volver arriba
    </button>
    <!-- ========================================
     SCRIPTS
========================================= -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

    <!-- YOUTUBE -->
    <script src="https://www.youtube.com/iframe_api"></script>

    <!-- NOTAS DESDE SUPABASE -->
    <div id="datosNotas" data-notas="<%= encodeURIComponent(JSON.stringify(notas || [])) %>" hidden></div>

    <!-- REPRODUCTOR / INTERFAZ -->
    <script src="/js/cliente.js?v=6"></script>

</body>

</html>