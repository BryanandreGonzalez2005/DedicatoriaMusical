<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css?v=5">
</head>
<body>
<main class="admin-dashboard">
  <div class="admin-shell">
    <div class="admin-topbar">
      <a href="/admin" class="brand">
        <span class="brand-mark">DM</span>
        <span class="brand-copy"><strong>Dedicatoria Musical</strong><span>Panel de administración</span></span>
      </a>
      <a href="/admin/canciones/nueva" class="btn-admin-option">Nueva canción</a>
    </div>
    <div class="admin-layout">
      
      <aside class="admin-sidebar">
        <p class="sidebar-label">Navegación</p>
        <nav class="sidebar-nav">
          <a href="/admin" class="sidebar-link ">
            <svg viewBox="0 0 24 24"><path d="M3 11.5 12 4l9 7.5"/><path d="M5 10.5V20h14v-9.5"/><path d="M9 20v-6h6v6"/></svg>
            <span>Inicio</span>
          </a>
          <a href="/admin/canciones" class="sidebar-link active">
            <svg viewBox="0 0 24 24"><path d="M9 18V5l10-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="16" cy="16" r="3"/></svg>
            <span>Canciones</span>
          </a>
          <a href="/" target="_blank" class="sidebar-link">
            <svg viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg>
            <span>Ver página</span>
          </a>
        </nav>
      </aside>

      <section class="admin-content">

        <header class="dashboard-header">
          <div>
            <a href="/admin" class="volver">← Volver al panel</a>
            <p class="dashboard-label">Biblioteca</p>
            <h1>Canciones</h1>
            <p class="dashboard-bienvenida">Administra las canciones de tu dedicatoria.</p>
          </div>
        </header>

        <% if (canciones && canciones.length > 0) { %>
          <div class="song-grid">
            <% canciones.forEach((cancion) => { %>
              <article class="admin-option song-card">
                <div class="song-cover-wrap">
                  <% if (cancion.url_portada) { %>
                    <img src="<%= cancion.url_portada %>" alt="Portada de <%= cancion.titulo %>" class="admin-cancion-portada">
                  <% } %>
                </div>
                <div class="song-card-body">
                  <h2><%= cancion.titulo %></h2>
                  <p class="song-artist"><%= cancion.artista %></p>
                  <div class="song-status">
                    <% if (cancion.visible) { %>
                      <span class="estado-visible">Visible</span>
                    <% } else { %>
                      <span class="estado-oculta">Oculta</span>
                    <% } %>
                    <% if (cancion.destacada) { %>
                      <span class="estado-destacada">Destacada</span>
                    <% } %>
                  </div>
                  <div class="acciones-cancion">
                    <a href="/admin/canciones/<%= cancion.id %>/editar" class="btn-admin-option">Editar</a>
                    <form action="/admin/canciones/<%= cancion.id %>/eliminar" method="POST" class="form-eliminar" data-titulo="<%= cancion.titulo %>">
                      <button type="submit" class="btn-eliminar">Eliminar</button>
                    </form>
                  </div>
                </div>
              </article>
            <% }); %>
          </div>
        <% } else { %>
          <article class="admin-option text-center">
            <h2>Todavía no hay canciones</h2>
            <p>Agrega la primera canción de tu dedicatoria.</p>
            <a href="/admin/canciones/nueva" class="btn-admin-option">Agregar canción</a>
          </article>
        <% } %>

      </section>
    </div>
  </div>
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  document.querySelectorAll(".form-eliminar").forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const titulo = form.dataset.titulo || "esta canción";
      const resultado = await Swal.fire({
        title: "¿Eliminar canción?",
        text: `Se eliminará "${titulo}". Esta acción no se puede deshacer.`,
        icon: "warning",
        showCancelButton: true,
        confirmButtonText: "Sí, eliminar",
        cancelButtonText: "Cancelar",
        reverseButtons: true,
        customClass: {
          popup: "admin-swal",
          confirmButton: "admin-swal-confirm",
          cancelButton: "admin-swal-cancel"
        }
      });
      if (resultado.isConfirmed) form.submit();
    });
  });
</script>
</body>
</html>
